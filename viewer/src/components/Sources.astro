---
import { sourceLink, type Source } from '../lib/data';
import Breakable from './Breakable.astro';
interface Props { sources: Source[]; title?: string; note?: string; open?: boolean }
const { sources, title = 'Sources', note, open = true } = Astro.props;
---
<details class="sources" open={open}>
  <summary>{title} ({sources.length})</summary>
  {note && <p class="muted srcnote">{note}</p>}
  <ul>
    {sources.map((s) => {
      const l = sourceLink(s);
      return (
        <li>
          <a href={l.href} rel="noopener"><Breakable text={l.label} /></a>
          {s.retrieved && <span> (retrieved {s.retrieved})</span>}
          {s.note && <span> — <Breakable text={s.note} /></span>}
        </li>
      );
    })}
  </ul>
</details>
