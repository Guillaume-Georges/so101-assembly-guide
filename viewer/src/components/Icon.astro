---
/**
 * Stroke icons on a 24 px grid, one per noun in the data model (brand proposal §5). Decorative by
 * default (aria-hidden); pass `label` to expose one to assistive tech.
 */
interface Props { name: IconName; size?: number; label?: string; class?: string }
export type IconName = 'part' | 'servo' | 'horn' | 'screw' | 'tool' | 'cable' | 'board' | 'check' | 'warn' | 'source';
const { name, size = 24, label, class: cls } = Astro.props;
const PATHS: Record<IconName, string> = {
  part: '<path d="M4 7h16v13H4zM8 7V4h8v3"/>',
  servo: '<rect x="5" y="4" width="14" height="16" rx="2"/><circle cx="12" cy="9" r="2.5"/>',
  horn: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2"/>',
  screw: '<path d="M12 3v14M8 7h8M9 17l3 4 3-4"/>',
  tool: '<path d="M4 20l8-8M12 12l6-6 2 2-6 6"/>',
  cable: '<path d="M4 18c4 0 4-12 8-12s4 12 8 12"/><circle cx="4" cy="18" r="1.5"/><circle cx="20" cy="18" r="1.5"/>',
  board: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h4M7 14h6M15 10h2M15 14h2"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
  warn: '<path d="M12 3L3 20h18z"/><path d="M12 9v5M12 17v1"/>',
  source: '<path d="M14 4h6v6M20 4l-8 8M11 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/>',
};
/** Map a BOM category to an icon; anything unknown is a generic part. */
export function iconForCategory(category?: string): IconName {
  switch (category) {
    case 'servo': return 'servo';
    case 'hardware': return 'horn';
    case 'electronics': return 'board';
    case 'cable': return 'cable';
    default: return 'part';
  }
}
---
<svg class:list={['ico', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={PATHS[name]} />
