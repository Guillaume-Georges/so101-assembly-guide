---
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import Flags from '../../../components/Flags.astro';
import { data, stepById, stepPath, parts } from '../../../lib/data';
import { withBase, breadcrumbs } from '../../../lib/seo';
export function getStaticPaths() {
  return data.troubleshooting.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const site = Astro.site ?? new URL('https://kitsmith.dev');
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: t.title, acceptedAnswer: { '@type': 'Answer', text: `${t.cause} Fix: ${t.fix}` } }] };
---
<Base title={t.title} path={`/troubleshooting/${t.slug}/`} section="/troubleshooting/" description={`${t.title}. Cause: ${t.cause}`.slice(0, 158)} noindex={!!t.unverified} jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Troubleshooting', path: '/troubleshooting/' }, { name: t.title, path: `/troubleshooting/${t.slug}/` }], site.toString()), faq]}>
  <p class="muted"><a href={withBase('/troubleshooting/')}>Troubleshooting</a></p>
  <h1>{t.title} <Flags unverified={t.unverified} /></h1>
  {t.aliases?.length ? <p class="muted">Also reported as: {t.aliases.join(' · ')}</p> : null}
  <div class="card">
    <h2>Symptoms</h2><ul>{t.symptoms.map((s) => <li>{s}</li>)}</ul>
    <h2>Cause</h2><p>{t.cause}</p>
    <h2>Fix</h2><p class="check">{t.fix}</p>
  </div>
  {t.related_steps?.length ? (<><h2>Related steps</h2><ul class="plain">{t.related_steps.map((id) => { const s = stepById(id); return s ? <li><a href={withBase(stepPath(s))}>{s.id} {s.title}</a></li> : null; })}</ul></>) : null}
  {t.related_parts?.length ? (<><h2>Related parts</h2><ul class="plain">{t.related_parts.map((id) => <li><a href={withBase(`/parts/${id}/`)}>{parts.get(id)?.name ?? id}</a></li>)}</ul></>) : null}
  <Sources sources={t.source} />
</Base>
