---
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import Flags from '../../../components/Flags.astro';
import StepPanel from '../../../components/StepPanel.astro';
import Viewer from '../../../island/Viewer';
import { ASSEMBLIES, steps, stepPath, stepNumber, stepGroups } from '../../../lib/data';
import { withBase, sitePath, breadcrumbs, techArticle, stepDescription } from '../../../lib/seo';
export function getStaticPaths() {
  return ASSEMBLIES.flatMap((assembly) =>
    steps(assembly).map((s, i) => ({ params: { assembly, step: `${stepNumber(s.id)}-${s.slug}` }, props: { s, i } })),
  );
}
const { assembly } = Astro.params as { assembly: string };
const { s, i } = Astro.props;
const list = steps(assembly);
const prev = list[i - 1];
const next = list[i + 1];
const groups = stepGroups(assembly);
const gi = groups.findIndex((g) => g.steps.includes(s));
/** One glossary `seen` set per page: a term gets its popover on first use only. */
const seen = new Set<string>();
const site = Astro.site ?? new URL('https://kitsmith.dev');
const arm = `${assembly[0].toUpperCase()}${assembly.slice(1)} arm`;
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: arm, path: `/${assembly}/` }, { name: `${s.id} ${s.title}`, path: stepPath(s) }], site.toString()),
  techArticle(s, site.toString()),
];
---
<Base title={`${s.id} ${s.title}`} path={stepPath(s)} section={`/${assembly}/`} description={stepDescription(s)} noindex={!!s.unverified} jsonLd={jsonLd} ogImage={`/og/${assembly}/${stepNumber(s.id)}.png`}>
  <div class="stepbar">
    <p class="muted"><a href={withBase(`/${assembly}/`)}>{arm}</a> · <strong>Step {i + 1} of {list.length}</strong> · <span class="id">{s.id}</span></p>
    <ol class="milestones" role="progressbar" aria-label={`Step ${i + 1} of ${list.length}, ${groups[gi].label}`} aria-valuemin="1" aria-valuemax={list.length} aria-valuenow={i + 1}>
      {groups.map((g, n) => {
        const done = n < gi;
        const here = n === gi;
        const within = here ? Math.round(((g.steps.indexOf(s) + 1) / g.steps.length) * 100) : done ? 100 : 0;
        return (
          <li class={done ? 'done' : here ? 'here' : ''} title={g.label}>
            <a href={withBase(stepPath(g.steps[0]))} aria-label={`${g.label}: ${g.steps.length} steps`}><span class="bar"><span style={`width:${within}%`}></span></span><span class="lbl">{g.label}</span></a>
          </li>
        );
      })}
    </ol>
  </div>
  <div class="titlebar">
    <span class="num" aria-hidden="true">{i + 1}</span>
    <h1>{s.title} <Flags unverified={s.unverified} approximation={s.approximation} /></h1>
  </div>
  {s.unverified && (
    <div class="banner"><strong>Unverified.</strong> Part of this step is not confirmed by any public source yet (see the sources below). Follow the upstream video for this joint and report what you find.</div>
  )}
  {!s.plain && <p class="goal"><strong>Done when</strong> {s.check}</p>}
  <div class="grid step">
    <div>
      <div class="viewer">
        <Viewer client:visible assembly={assembly} stepId={s.id} base={sitePath('/')} />
        <noscript><p class="fallback">3D view needs JavaScript; every instruction is in the text.</p></noscript>
      </div>
    </div>
    <StepPanel s={s} seen={seen} />
  </div>
  <Sources sources={s.source} note={s.extends && assembly === 'leader' ? `Upstream numbers the follower's steps; this leader step is the same build step (extends ${s.extends}).` : undefined} />
  {s.provenance && <details class="provenance muted"><summary>How we placed it</summary><p>{s.provenance}</p></details>}
  {!next && (
    <section class="finished">
      <h2>{arm} built.</h2>
      <p>That was the last of the {list.length} steps. Calibration and the LeRobot software setup are outside this guide; the upstream page carries on from here.</p>
      <div class="actions">
        <a class="button primary" href="https://github.com/huggingface/lerobot/blob/3f2c29ef7e44b1ddccbcda3b6a63939e53639e9e/docs/source/so101.mdx" rel="noopener">Continue on the LeRobot SO-101 page →</a>
        <a class="button" href={withBase(assembly === 'follower' ? '/leader/' : '/follower/')}>Build the {assembly === 'follower' ? 'leader' : 'follower'} arm</a>
        <a class="button" href={withBase('/troubleshooting/')}>Something's wrong</a>
      </div>
    </section>
  )}
  <nav class="steps" aria-label="Step navigation">
    <div class="wrap">
      {prev ? (
        <a href={withBase(stepPath(prev))} rel="prev" class="prev"><small>← {prev.id}</small><span>{prev.title_short ?? prev.title}</span></a>
      ) : (
        <a href={withBase(`/${assembly}/`)} class="prev"><small>←</small><span>All steps</span></a>
      )}
      <span class="count">{i + 1} / {list.length}</span>
      {next ? (
        <a href={withBase(stepPath(next))} rel="next" class="next"><small>Next · {next.id}</small><span>{next.title_short ?? next.title} →</span></a>
      ) : (
        <a href={withBase(`/${assembly}/`)} class="next"><small>Done ✓</small><span>Back to all steps</span></a>
      )}
    </div>
  </nav>
</Base>
