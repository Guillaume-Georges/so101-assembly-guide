---
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import Flags from '../../../components/Flags.astro';
import StepPanel from '../../../components/StepPanel.astro';
import Viewer from '../../../island/Viewer';
import { ASSEMBLIES, steps, stepPath, stepNumber } from '../../../lib/data';
import { withBase, breadcrumbs, techArticle, stepDescription, sitePath } from '../../../lib/seo';
export function getStaticPaths() {
  return ASSEMBLIES.flatMap((assembly) =>
    steps(assembly).map((s, i) => ({ params: { assembly, step: `${stepNumber(s.id)}-${s.slug}` }, props: { s, i } })),
  );
}
const { assembly } = Astro.params as { assembly: string };
const { s, i } = Astro.props;
const list = steps(assembly);
const prev = list[i - 1];
const next = list[i + 1];
const site = Astro.site ?? new URL('https://kitsmith.dev');
const arm = `${assembly[0].toUpperCase()}${assembly.slice(1)} arm`;
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: arm, path: `/${assembly}/` }, { name: `${s.id} ${s.title}`, path: stepPath(s) }], site.toString()),
  techArticle(s, site.toString()),
];
---
<Base title={`${s.id} ${s.title}`} path={stepPath(s)} section={`/${assembly}/`} description={stepDescription(s)} noindex={!!s.unverified} jsonLd={jsonLd} ogImage={`/og/${assembly}/${stepNumber(s.id)}.png`}>
  <div class="stepbar">
    <p class="muted"><a href={withBase(`/${assembly}/`)}>{arm}</a> · <strong>Step {i + 1} of {list.length}</strong> · <span class="id">{s.id}</span></p>
    <div class="progress" role="progressbar" aria-label={`Step ${i + 1} of ${list.length}`} aria-valuemin="1" aria-valuemax={list.length} aria-valuenow={i + 1}><span style={`width:${Math.round(((i + 1) / list.length) * 100)}%`}></span></div>
  </div>
  <h1>{s.title} <Flags unverified={s.unverified} approximation={s.approximation} /></h1>
  {s.unverified && (
    <div class="banner"><strong>Unverified.</strong> Part of this step is not confirmed by any public source yet (see the sources below). Follow the upstream video for this joint and report what you find.</div>
  )}
  <p class="goal"><strong>Done when</strong> {s.check}</p>
  <div class="grid step">
    <div>
      <div class="viewer">
        <Viewer client:visible assembly={assembly} stepId={s.id} base={sitePath('/')} />
        <noscript><p class="fallback">3D view needs JavaScript; every instruction is in the text.</p></noscript>
      </div>
    </div>
    <StepPanel s={s} />
  </div>
  <Sources sources={s.source} />
  <nav class="steps" aria-label="Step navigation">
    <div class="wrap">
      {prev ? (
        <a href={withBase(stepPath(prev))} rel="prev" class="prev"><small>← {prev.id}</small><span>{prev.title}</span></a>
      ) : (
        <a href={withBase(`/${assembly}/`)} class="prev"><small>←</small><span>All steps</span></a>
      )}
      <span class="count">{i + 1} / {list.length}</span>
      {next ? (
        <a href={withBase(stepPath(next))} rel="next" class="next"><small>Next · {next.id}</small><span>{next.title} →</span></a>
      ) : (
        <a href={withBase(`/${assembly}/`)} class="next"><small>Done ✓</small><span>Back to all steps</span></a>
      )}
    </div>
  </nav>
</Base>
