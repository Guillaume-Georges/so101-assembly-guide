---
import Base from '../../../layouts/Base.astro';
import Flags from '../../../components/Flags.astro';
import { ASSEMBLIES, steps, stepPath, stepGroups, data, JOINT_ORDER, jointLabel } from '../../../lib/data';
import { withBase, breadcrumbs } from '../../../lib/seo';
export function getStaticPaths() {
  return ASSEMBLIES.map((assembly) => ({ params: { assembly } }));
}
const { assembly } = Astro.params as { assembly: string };
const list = steps(assembly);
const groups = stepGroups(assembly);
const first = list[0];
const servos = JOINT_ORDER.map((j) => data.servos.find((s) => s.assembly === assembly && s.joint === j)).filter(Boolean);
const title = `${assembly[0].toUpperCase()}${assembly.slice(1)} arm assembly`;
const site = Astro.site ?? new URL('https://kitsmith.dev');
---
<Base title={title} path={`/${assembly}/`} section={`/${assembly}/`} description={`All ${list.length} SO-101 ${assembly} arm assembly steps in upstream order, with servo, screws, tool and check for each.`} jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: title, path: `/${assembly}/` }], site.toString())]}>
  <h1>{title}</h1>
  <p>{list.length} steps in the order of the LeRobot SO-101 page, grouped by motor. Each step says what you need, what to do, and what "done" looks like.</p>
  <div class="actions">
    <a class="button primary" id="start" href={withBase(stepPath(first))}>Start at step 1 →</a>
    <a class="button" id="resume" href={withBase(stepPath(first))} hidden>Resume where you left off →</a>
  </div>
  <h2>Steps</h2>
  {groups.map((g) => (
    <section class="group">
      <h3><span class="key">{g.key === '0' ? 'Prep' : g.key === '7' ? 'End' : g.key}</span> {g.label}</h3>
      <ol class="steps">
        {g.steps.map((s) => (
          <li>
            <a href={withBase(stepPath(s))} title={s.title}><span class="id">{s.id}</span> <span class="t">{s.title_short ?? s.title}</span></a>
            {s.prep && <span class="flag prep" title="Preparation: do this before assembling">do first</span>}
            <Flags unverified={s.unverified} approximation={s.approximation} />
          </li>
        ))}
      </ol>
    </section>
  ))}
  <details class="reference">
    <summary><h2>Servos for this arm</h2></summary>
    <div class="tblwrap"><table>
      <thead><tr><th>ID</th><th>Joint</th><th>Gear ratio</th><th>Servo</th><th>Supply</th></tr></thead>
      <tbody>{servos.map((s) => s && (
        <tr><td>{s.bus_id}</td><td><a href={withBase(`/servos/${s.assembly}/${s.joint}/`)}>{jointLabel(s.joint)}</a></td><td>{s.gear_ratio}</td><td><a href={withBase(`/parts/${s.part}/`)}>{s.part}</a></td><td>{s.variants.map((v) => `${v.servo_voltage} → ${v.supply}`).join(' / ')}</td></tr>
      ))}</tbody>
    </table></div>
  </details>
  <script is:inline define:vars={{ assembly }}>
    // Resume where you left off: the primary action becomes "Resume" when this device has a last step.
    try {
      const last = localStorage.getItem(`so101:last:${assembly}`);
      const resume = document.getElementById('resume');
      const start = document.getElementById('start');
      if (last && resume && start) {
        resume.href = last;
        resume.hidden = false;
        resume.classList.add('primary');
        start.classList.remove('primary');
      }
    } catch {}
  </script>
</Base>
