---
import '../../../../styles/global.css';
import Viewer from '../../../../island/Viewer';
import { ASSEMBLIES, steps, stepNumber, stepPath } from '../../../../lib/data';
import { withBase, sitePath } from '../../../../lib/seo';
import { islandPreloads } from '../../../../lib/preload';
export function getStaticPaths() {
  return ASSEMBLIES.flatMap((assembly) => steps(assembly).map((s) => ({ params: { assembly, step: `${stepNumber(s.id)}-${s.slug}` }, props: { s } })));
}
const { assembly } = Astro.params as { assembly: string };
const { s } = Astro.props;
const site = Astro.site ?? new URL('https://kitsmith.dev');
const preloads = islandPreloads(assembly, s.id, sitePath('/'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.id} {s.title} — embed</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(withBase(stepPath(s)), site).toString()} />
    {preloads.map((href) => <link rel="preload" href={href} as="fetch" crossorigin />)}
    <style>html, body { height: 100%; margin: 0; } .viewer { min-height: 100vh; border: 0; border-radius: 0; }</style>
  </head>
  <body>
    <div class="viewer">
      <Viewer client:load assembly={assembly} stepId={s.id} base={sitePath('/')} embed />
      <a class="pick steplink" style="top:0.5rem;left:0.5rem;max-width:calc(100% - 13rem);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title={`${s.id} ${s.title}`} href={new URL(withBase(stepPath(s)), site).toString()} target="_blank" rel="noopener">{s.id} {s.title} ↗</a>
    </div>
    <script>
      // Inside a frame (the Hugging Face Space, a vendor wiki) ← and → are relayed to the host page,
      // which owns the step list, so the keys work wherever the focus is. Not when the focusable 3D
      // view has focus: there the arrows turn the model (KeyOrbit), also while it is still loading.
      // Nothing sensitive is sent, hence the '*' target; the host checks the origin.
      if (window.parent !== window)
        document.addEventListener('keydown', (e) => {
          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
          const delta = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
          if (!delta) return;
          if ((e.target as HTMLElement | null)?.closest?.('[role="img"][tabindex]')) return;
          e.preventDefault();
          window.parent.postMessage({ kitsmith: 'step', delta }, '*');
        });
    </script>
  </body>
</html>
