---
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import { data } from '../../../lib/data';
import { breadcrumbs } from '../../../lib/seo';
const site = Astro.site ?? new URL('https://kitsmith.dev');
---
<Base title="Print settings" path="/print-settings/" description="Upstream 3D print settings for the SO-101 parts: PLA+, 0.4 mm nozzle at 0.2 mm layers, 15% infill, supports everywhere except horizontal screw holes, gauge prints first." jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Print settings', path: '/print-settings/' }], site.toString())]}>
  <h1>Print settings</h1>
  <div class="tblwrap"><table>
    <thead><tr><th>Setting</th><th>Upstream value</th><th>Source</th></tr></thead>
    <tbody>{data.printing.map((r) => <tr><td><strong>{r.setting}</strong></td><td>{r.value}</td><td><Sources sources={r.source} title="src" /></td></tr>)}</tbody>
  </table></div>
</Base>
