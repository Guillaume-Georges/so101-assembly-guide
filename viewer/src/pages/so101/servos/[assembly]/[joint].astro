---
import Base from '../../../../layouts/Base.astro';
import Sources from '../../../../components/Sources.astro';
import { data, jointLabel, stepPath } from '../../../../lib/data';
import { withBase, breadcrumbs } from '../../../../lib/seo';
export function getStaticPaths() {
  return data.servos.map((s) => ({ params: { assembly: s.assembly, joint: s.joint }, props: { s } }));
}
const { s } = Astro.props;
const stepsUsing = (data.assemblies[s.assembly] ?? []).filter((st) => st.servo_slot === s.joint);
const site = Astro.site ?? new URL('https://kitsmith.dev');
const title = `${s.assembly} ${jointLabel(s.joint)} servo`;
---
<Base title={title} path={`/servos/${s.assembly}/${s.joint}/`} section="/servos/" description={`SO-101 ${s.assembly} ${jointLabel(s.joint)}: bus ID ${s.bus_id}, ${s.model} ${s.gear_ratio}, ${s.variants.map((v) => v.servo_voltage + ' on ' + v.supply).join(' or ')}.`} jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Servos', path: '/servos/' }, { name: title, path: `/servos/${s.assembly}/${s.joint}/` }], site.toString())]}>
  <p class="muted"><a href={withBase('/servos/')}>Servos</a> · {s.assembly}</p>
  <h1>{jointLabel(s.joint)} — ID {s.bus_id}, {s.model} {s.gear_ratio}</h1>
  <div class="card">
    <ul class="plain">
      <li><strong>Default part:</strong> <a href={withBase(`/parts/${s.part}/`)}>{s.part}</a></li>
      {s.variants.map((v) => <li><strong>{v.default ? 'Standard' : 'Optional'}:</strong> <a href={withBase(`/parts/${v.part}/`)}>{v.part}</a>, {v.servo_voltage} servo, {v.supply} supply. {v.note}</li>)}
      {s.orientation_note && <li><strong>Orientation:</strong> {s.orientation_note}</li>}
      {s.notes && <li>{s.notes}</li>}
    </ul>
  </div>
  <h2>Steps for this joint</h2>
  <ul class="plain">{stepsUsing.map((st) => <li><a href={withBase(stepPath(st))}>{st.id} {st.title}</a></li>)}</ul>
  <Sources sources={[...s.source, ...s.variants.flatMap((v) => v.source)]} />
</Base>
