---
import Base from '../layouts/Base.astro';
import { data, steps } from '../lib/data';
import { withBase, sitePath } from '../lib/seo';
const site = Astro.site ?? new URL('https://kitsmith.dev');
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Kitsmith', url: new URL(sitePath('/'), site).toString(), description: 'Source-traceable build companions for open-hardware kits.' }];
---
<Base title="Kitsmith" path="/" description="Kitsmith: source-traceable, step-by-step build companions for open-hardware kits. First guide: the SO-101 robot arm, with a 3D view for every step." jsonLd={jsonLd}>
  <h1>Kitsmith</h1>
  <p>Build companions for open-hardware kits: one page per step, the exact parts and screws, a check before you move on, and a source for every fact. Nothing invented; what no source confirms is flagged.</p>
  <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
    <a class="card" href={withBase('/')}>
      <h2>SO-101 robot arm</h2>
      <p>{steps('follower').length + steps('leader').length} steps across the follower and leader arms, {data.parts.length} parts, servo and gear ratio per joint, 3D view per step.</p>
    </a>
  </div>
  <p class="muted">More kits later. Source and corrections on <a href="https://github.com/Guillaume-Georges/so101-assembly-guide">GitHub</a>.</p>
</Base>
