---
import '../styles/global.css';
import { SITE_NAME, BRAND, GUIDE_NAME, DESCRIPTION, withBase, sitePath, NOINDEX } from '../lib/seo';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  path: string; // site-relative, starts with /, ends with /
  noindex?: boolean;
  jsonLd?: unknown[];
  ogImage?: string; // site-relative path to a PNG
  section?: string;
}
const { title, description = DESCRIPTION, path, noindex = false, jsonLd = [], ogImage, section } = Astro.props;
const site = Astro.site ?? new URL('https://kitsmith.dev');
const canonicalPath = path === '/' ? sitePath('/') : withBase(path);
const canonical = new URL(canonicalPath, site).toString();
const og = new URL(withBase(ogImage ?? '/og/site.png'), site).toString();
const analytics = import.meta.env.PUBLIC_ANALYTICS_SCRIPT as string | undefined;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN as string | undefined;
// "{page} · SO-101 guide · Kitsmith": kit first (what people search), brand last (what accumulates).
const landing = path === '/';
const fullTitle = landing ? title : title === SITE_NAME ? `${GUIDE_NAME} · ${BRAND}` : `${title} · ${GUIDE_NAME} · ${BRAND}`;
const nav = [
  ['Follower', '/follower/'],
  ['Leader', '/leader/'],
  ['Servos', '/servos/'],
  ['Parts', '/parts/'],
  ['Troubleshooting', '/troubleshooting/'],
  ['Kits', '/kits/'],
  ['FAQ', '/faq/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme choice (system / light / dark) applied before paint so there is no flash.
      try {
        const t = localStorage.getItem('so101:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || NOINDEX) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#101827" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&display=swap" />
    <link rel="manifest" href={sitePath('/manifest.webmanifest')} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    {!NOINDEX && <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />}
    {jsonLd.map((o) => <script is:inline type="application/ld+json" set:html={JSON.stringify(o)} />)}
    {analytics && <script is:inline defer data-domain={analyticsDomain} src={analytics}></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={sitePath('/')}>
          <svg class="mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8.5 5v10L12 22l-8.5-5V7z" /><circle cx="12" cy="12" r="3" /></svg>
          {BRAND}
        </a>
        {!landing && (
          <a class="guide" href={withBase('/')} title={SITE_NAME}><span class="sep" aria-hidden="true">/</span>SO-101</a>
        )}
        <details class="menu" open>
          <summary aria-label="Menu and search">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
            Menu
          </summary>
          <nav class="primary" aria-label="Sections">
            {nav.map(([label, href]) => (
              <a href={withBase(href)} aria-current={section === href ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
          <Search />
        </details>
        <button type="button" class="theme" aria-label="Theme: follows your device" title="Theme: follows your device" data-theme-toggle>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Every fact on this site cites a public source; upstream design by
          <a href="https://github.com/TheRobotStudio/SO-ARM100">TheRobotStudio / Hugging Face LeRobot</a> (Apache-2.0).
          Steps marked <span class="flag unverified">unverified</span> contain content no source confirms yet; geometry marked
          <span class="flag approximation">approximation</span> is a stand-in. Not affiliated with any kit vendor.
        </p>
        <p>
          <a href="https://github.com/Guillaume-Georges/so101-assembly-guide">Source, data and corrections on GitHub</a> ·
          <a href={withBase('/print-settings/')}>Print settings</a> · <a href={withBase('/compare/so-100-vs-so-101/')}>SO-100 vs SO-101</a>
        </p>
      </div>
    </footer>
    <script>
      // Narrow screens: start with the menu closed so the sticky header is one row. Without JS it stays
      // open (today's layout), so the links are always reachable.
      try {
        const menu = document.querySelector('details.menu') as HTMLDetailsElement | null;
        const narrow = window.matchMedia('(max-width: 59.99rem)');
        if (menu) {
          const sync = () => {
            menu.open = !narrow.matches;
          };
          sync();
          narrow.addEventListener('change', sync);
        }
      } catch {}
      // Theme toggle: system -> light -> dark -> system, remembered per device.
      try {
        const btn = document.querySelector('[data-theme-toggle]') as HTMLButtonElement | null;
        const NAMES: Record<string, string> = { system: 'follows your device', light: 'light', dark: 'dark' };
        const current = () => document.documentElement.dataset.theme ?? 'system';
        const apply = (t: string) => {
          if (t === 'system') {
            delete document.documentElement.dataset.theme;
            localStorage.removeItem('so101:theme');
          } else {
            document.documentElement.dataset.theme = t;
            localStorage.setItem('so101:theme', t);
          }
          if (btn) {
            btn.setAttribute('aria-label', `Theme: ${NAMES[t]}. Press to change`);
            btn.title = `Theme: ${NAMES[t]}`;
            btn.dataset.state = t;
          }
        };
        if (btn) {
          apply(current());
          btn.addEventListener('click', () => {
            const order = ['system', 'light', 'dark'];
            apply(order[(order.indexOf(current()) + 1) % order.length]);
          });
        }
      } catch {}
      // Resume where you left off: remember the last step visited per arm (per-device convenience only).
      try {
        const m = location.pathname.match(/\/(follower|leader)\/(\d{3})-/);
        if (m) localStorage.setItem(`so101:last:${m[1]}`, location.pathname);
      } catch {}
    </script>
  </body>
</html>
