{
  "ci": {
    "collect": {
      "staticDistDir": "./viewer/dist",
      "url": [
        "http://localhost/so101-assembly-guide/follower/011-follower-joint1-motor-into-base/",
        "http://localhost/so101-assembly-guide/",
        "http://localhost/so101-assembly-guide/troubleshooting/setup-motors-error-check-cables/"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1500000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
