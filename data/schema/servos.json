{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://so101-assembly-guide/schema/servos.json",
  "title": "servos.yaml \u2014 joint to servo assignment",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.json#/$defs/id"
      },
      "assembly": {
        "$ref": "common.json#/$defs/assembly"
      },
      "joint": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Slot name referenced by steps' servo_slot, e.g. shoulder_lift"
      },
      "part": {
        "$ref": "common.json#/$defs/id",
        "description": "parts.yaml id of the DEFAULT servo variant for this joint (must also appear in variants)"
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "description": "e.g. STS3215"
      },
      "gear_ratio": {
        "type": "string",
        "pattern": "^1:\\d+$",
        "description": "Reduction as 1:N, e.g. 1:345"
      },
      "variants": {
        "type": "array",
        "minItems": 1,
        "description": "Every servo variant a source allows at this joint, with its own supply voltage. Never a single voltage value (D-002).",
        "items": {
          "type": "object",
          "properties": {
            "part": {
              "$ref": "common.json#/$defs/id"
            },
            "servo_voltage": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?V$",
              "description": "Rated servo voltage, e.g. 7.4V"
            },
            "supply": {
              "type": "string",
              "minLength": 1,
              "description": "Power supply to use with this variant, e.g. 5V or 12V 5A+"
            },
            "default": {
              "type": "boolean",
              "default": false
            },
            "note": {
              "type": "string"
            },
            "source": {
              "$ref": "common.json#/$defs/sources"
            }
          },
          "required": ["part", "servo_voltage", "supply", "source"],
          "additionalProperties": false
        }
      },
      "bus_id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 253,
        "description": "Servo bus ID the upstream guide assigns to this joint"
      },
      "orientation_note": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "source": {
        "$ref": "common.json#/$defs/sources"
      },
      "unverified": {
        "type": "boolean",
        "default": false
      },
      "approximation": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["id", "assembly", "joint", "part", "model", "gear_ratio", "variants", "source"],
    "additionalProperties": false
  }
}
