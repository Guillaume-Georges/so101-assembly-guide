{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://so101-assembly-guide/schema/assembly.json",
  "title": "assemblies/<name>.yaml — ordered build steps",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[FL]-\\d{3}$",
        "description": "F-### for follower, L-### for leader. Stable; never reused."
      },
      "title": { "type": "string", "minLength": 1 },
      "assembly": { "$ref": "common.json#/$defs/assembly" },
      "parts": {
        "type": "array",
        "items": { "$ref": "common.json#/$defs/id" },
        "minItems": 1,
        "uniqueItems": true,
        "description": "parts.yaml ids installed in this step"
      },
      "servo_slot": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "joint name resolved via servos.yaml for this assembly"
      },
      "orientation_note": { "type": "string" },
      "fasteners": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "$ref": "common.json#/$defs/id" },
            "qty": { "type": "integer", "minimum": 1 }
          },
          "required": ["id", "qty"],
          "additionalProperties": false
        }
      },
      "tools": {
        "type": "array",
        "items": { "$ref": "common.json#/$defs/id" },
        "uniqueItems": true
      },
      "cable_path": {
        "type": "array",
        "items": { "$ref": "common.json#/$defs/point3" },
        "minItems": 2
      },
      "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "check": {
        "type": "string",
        "minLength": 1,
        "description": "Verification the builder performs before moving on"
      },
      "instructions": {
        "type": "string",
        "description": "Free-text detail; must not introduce facts absent from source"
      },
      "source": { "$ref": "common.json#/$defs/sources" },
      "unverified": { "type": "boolean", "default": false },
      "approximation": { "type": "boolean", "default": false }
    },
    "required": ["id", "title", "assembly", "parts", "check", "source"],
    "additionalProperties": false
  }
}
